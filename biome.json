{
	"$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"src/**",
			"server/**",
			"scripts/**",
			"vite.config.ts",
			"eslint.config.js",
			"package.json",
			"biome.json",
			"tsconfig.json",
			"tsconfig.app.json",
			"tsconfig.node.json",
			"src-tauri/tauri.conf.json",
			"src-tauri/capabilities/**",
			"!!src-tauri/gen",
			"!!src-tauri/target",
			"!!dist",
			"!!node_modules",
			"!!server/data"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
